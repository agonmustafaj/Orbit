# ORBIT environment configuration
# Copy to .env and fill in values. Never commit .env.

APP_NAME=ORBIT
APP_ENV=development
DEBUG=true

# Public site URL (SEO / Open Graph)
SITE_URL=http://localhost:8000

# Contact / creator
CONTACT_NAME=Agon Mustafaj
CONTACT_EMAIL=agonmustafaj01@gmail.com
CREATOR_URL=https://agonmustafaj.com/

# CORS origins (comma-separated). Empty = same-origin only via FastAPI defaults.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
