# ORBIT environment configuration
# Copy to .env and fill in values. Never commit .env.

APP_NAME=ORBIT
APP_ENV=development
DEBUG=true

# Public site URL (SEO / Open Graph)
SITE_URL=http://localhost:8000

# Contact
CONTACT_NAME=Agon Mustafaj
CONTACT_EMAIL=agonmustafaj01@gmail.com
CONTACT_TO=agonmustafaj01@gmail.com

# Optional email delivery (leave empty to validate-only / log)
# When unset, POST /api/contact accepts the message but does not claim delivery.
RESEND_API_KEY=
CONTACT_FROM=

# CORS origins (comma-separated). Empty = same-origin only via FastAPI defaults.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Basic contact rate limiting (requests per window per IP)
CONTACT_RATE_LIMIT=8
CONTACT_RATE_WINDOW_SECONDS=60
